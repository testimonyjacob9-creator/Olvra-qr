rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Love messages: anyone with the link can read one message, nobody can list, edit or delete.
    // Love messages are now created only by the create-love function (admin
    // SDK, which bypasses these rules) so the free-message limit can't be
    // bypassed from the browser. Anyone with the link can still read one.
    match /love/{id} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Abuse reports: write-only from the public.
    match /loveReports/{rid} {
      allow create: if request.resource.data.keys().hasOnly(['id','at'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 20
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // Premium status: a signed-in user can read only their own record. Only the server writes it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Users may update only their own display name and photo — every other
      // field (premiumUntil, loveCount, email) is written only by server
      // functions using the admin SDK, which bypasses these rules.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL','displayName','pushSubscription']);
      allow create: if false;
      allow delete: if false;

      // Notifications: the owner can read their own and mark them read.
      // Only server functions (via notifyUser) create them.
      match /notifications/{nid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // Admin membership and the support inbox are read only through admin-*
    // functions (admin SDK), never directly by clients.
    match /admins/{uid} { allow read, write: if false; }
    match /support_messages/{id} { allow read, write: if false; }

    // Password-reset and email-verify codes: server only. No client access at all.
    match /authCodes/{docId} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
